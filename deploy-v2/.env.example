# Локальные секреты для dev-стека v4. Скопируй в .env (не коммитится).
# Все значения здесь — ТОЛЬКО для локалки. Для прода см. .env.deploy в DEPLOY.md.

# PostgreSQL
POSTGRES_USER=grovework
POSTGRES_PASSWORD=grovework_local
POSTGRES_DB=grovework_v4

# Auth — PASETO v4 ключ (32 байта в hex). Локальный фиксированный.
# В проде сгенерируй через `make dev/gen-key`.
PASETO_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Базовый URL фронта — для ссылок в письмах
APP_BASE_URL=http://localhost:3000

# OpenAI (Этап 7 — ai-сервис). Оставь пустым если ai не нужен в dev.
OPENAI_API_KEY=
